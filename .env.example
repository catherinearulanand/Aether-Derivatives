# AETHER configuration. Copy to .env — .env is gitignored and must never be committed.

# replay = extraction served from fixtures, no network. The demo must work in this mode.
# live   = real model calls. Optional. Never a hard dependency.
AETHER_MODE=replay

# Only read when AETHER_MODE=live. Leave unset for replay.
ANTHROPIC_API_KEY=

# Pinned so extraction results stay reproducible across runs.
AETHER_MODEL_ID=claude-opus-5

# This machine's outbound TLS is intercepted by Norton Web/Mail Shield.
# Python's default context and certifi both fail CA validation; the Windows
# trust store succeeds. Leave enabled unless verify_env.py says otherwise.
AETHER_USE_TRUSTSTORE=true

AETHER_DB_URL=sqlite:///./aether.db
AETHER_ENGINE_VERSION=0.1.0

# A browser treats localhost and 127.0.0.1 as different origins. Allow both.
AETHER_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
